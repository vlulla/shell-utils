#!/usr/bin/env -S bash
##
## $ (. ./find-path-executables)
##
##
case "$(uname -o)" in
  (*Linux*)  find $(echo ${PATH} | tr ':' ' ') -mindepth 1 -maxdepth 1 -type f -executable  -exec ls -la '{}' '+' 2>/dev/null | duckdb -column -no-init -c "with _ as(select regexp_split_to_array(column0,' +') a from read_csv('/dev/stdin',header=false,strict_mode=false))select a[-1] as fname,round(a[5]::int/(1024*1024),2) as sz_mb from _ order by sz_mb" ;;
  (*Darwin*) find $(echo ${PATH} | tr ':' ' ') -mindepth 1 -maxdepth 1 -type f -perm +00111 -exec ls -la '{}' '+' 2>/dev/null | duckdb -column -no-init -c "with _ as(select regexp_split_to_array(column0,' +') a from read_csv('/dev/stdin',header=false,strict_mode=false))select a[-1] as fname,round(a[5]::int/(1024*1024),2) as sz_mb from _ order by sz_mb" ;;
  (*) echo "Don't know how to run on $(uname -o)" ;;
esac
